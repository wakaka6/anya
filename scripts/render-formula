#!/usr/bin/env bash
# Prints Formula/anya.rb for a release (docs/decisions/0014).
#
#   TAG        the release tag, e.g. v0.3.1 (required)
#   REPO       owner/name of the repository hosting the release (required)
#   SUMS_FILE  the release's SHA256SUMS: "<sha256>  <file name>" lines (required)
#
# The `version` line is what a running Anya reads to learn that a newer
# version exists, so it is always written out.
set -euo pipefail

: "${TAG:?TAG is required, e.g. v0.3.1}"
: "${REPO:?REPO is required, e.g. wakaka6/anya}"
: "${SUMS_FILE:?SUMS_FILE is required}"

version="${TAG#v}"
base="https://github.com/${REPO}/releases/download/${TAG}"

sum_of() {
  local name="$1" sum
  sum="$(awk -v n="$name" '$2 == n { print $1 }' "$SUMS_FILE")"
  if [[ ! "$sum" =~ ^[0-9a-f]{64}$ ]]; then
    echo "render-formula: no sha256 for $name in $SUMS_FILE" >&2
    exit 1
  fi
  printf '%s' "$sum"
}

darwin_arm64="$(sum_of anya_darwin_arm64.tar.gz)"
darwin_amd64="$(sum_of anya_darwin_amd64.tar.gz)"
linux_arm64="$(sum_of anya_linux_arm64.tar.gz)"
linux_amd64="$(sum_of anya_linux_amd64.tar.gz)"

cat <<EOF
# Generated by the release workflow of ${REPO}; edits here are overwritten.
class Anya < Formula
  desc "Local speech-to-text service: hotkey dictation, continuous transcription, apps subscribe"
  homepage "https://github.com/${REPO}"
  version "${version}"
  license "MIT"

  on_macos do
    on_arm do
      url "${base}/anya_darwin_arm64.tar.gz"
      sha256 "${darwin_arm64}"
    end
    on_intel do
      url "${base}/anya_darwin_amd64.tar.gz"
      sha256 "${darwin_amd64}"
    end
  end

  on_linux do
    on_arm do
      url "${base}/anya_linux_arm64.tar.gz"
      sha256 "${linux_arm64}"
    end
    on_intel do
      url "${base}/anya_linux_amd64.tar.gz"
      sha256 "${linux_amd64}"
    end
  end

  def install
    bin.install "anya"
  end

  def caveats
    on_linux do
      <<~EOS
        Anya's window and tray use the system's WebKitGTK, GTK and AppIndicator,
        and pasting needs a clipboard tool. On Debian or Ubuntu:
          sudo apt install libwebkit2gtk-4.1-0 libayatana-appindicator3-1 libxdo3 libxtst6 xclip wl-clipboard wtype
        Other distributions, and the input group Wayland hotkeys need:
          https://github.com/${REPO}#linux
        anya --doctor lists anything still missing.
      EOS
    end
  end

  test do
    assert_match "anya", shell_output("#{bin}/anya --help")
  end
end
EOF
